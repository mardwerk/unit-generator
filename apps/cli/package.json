{
  "name": "@mardwerk/unit-cli",
  "version": "0.2.0",
  "description": "Stateless generation, research, validation and explicit export.",
  "license": "MPL-2.0",
  "type": "module",
  "bin": {
    "mardwerk-unit": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
