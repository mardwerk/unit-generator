OPENROUTER_API_KEY=
# Optional. Omit to use the free router.
OPENROUTER_MODEL=openrouter/free
# Optional. none keeps interactive drafts fast; low, medium and high are also supported.
OPENROUTER_REASONING=none
# Optional role ranking after a draft. Keys never enter artifacts or browser responses.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
# auto prefers configured TypesafeAI; otherwise an explicitly configured OpenRouter JEV model.
# Missing credentials or an unavailable model never block generation.
UNIT_ROLE_PROVIDER=auto
# Verified latest-family alias via the OpenRouter Decisions API. A pinned typesafe/jev-1.13 is also supported.
# No automatic model or provider fallback. Generation uses OPENROUTER_MODEL separately.
OPENROUTER_JEV_MODEL=~typesafe/jev-latest

# Optional paid icon generation. Every image requires confirmation in its icon dialog.
OPENROUTER_IMAGE_MODEL=meta/muse-image
