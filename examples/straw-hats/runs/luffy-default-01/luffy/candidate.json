  "paths": [
    {
      "id": "elastic-combat",
      "name": "Elastic Combat",
      "description": "Stretch, recoil and inventive targeting. Gear reach and impact shapes are modeled directly; Mizu Luffy, Afro Luffy and Nightmare Luffy are omitted as situational or externally granted forms.",
      "upgrades": [
        {
          "name": "Elastic Reach",
          "description": "Extends Luffy's direct-contact reach for long-distance punches and kicks.",
          "cost": 180,
          "modifiers": {
            "reachAdd": 2
          }
        },
        {
          "name": "Twisting Momentum",
          "description": "Rotating and recoiling limbs hit harder without adding a new power.",
          "cost": 260,
          "modifiers": {
            "damageMultiplier": 1.08
          }
        },
        {
          "name": "Instinctive Retargeting",
          "description": "Luffy can replace a lost primary target when a stretched attack resolves.",
          "cost": 340,
          "modifiers": {
            "retargetPrimary": true
          }
        },
        {
          "name": "Long-Arm Recoil",
          "description": "Further extends elastic attacks, improving access to distant targets and collateral lines.",
          "cost": 430,
          "modifiers": {
            "reachAdd": 2.5
          }
        },
        {
          "name": "Unorthodox Angles",
          "description": "Improves elastic damage and enables primary acquisition against concealed targets.",
          "cost": 560,
          "modifiers": {
            "damageMultiplier": 1.12,
            "detectConcealed": true
          }
        }
      ]
    },
    {
      "id": "armament-haki",
      "name": "Armament Haki",
      "description": "Armament adds force, armor bypass and internal damage. Contact stun is conditional on Manga eligibility and does not claim universal intangibility or seastone immunity.",
      "upgrades": [
        {
          "name": "Hardening",
          "description": "Armament-coated strikes add flat damage to every successful hit.",
          "cost": 190,
          "modifiers": {
            "flatDamage": 6
          }
        },
        {
          "name": "Emission",
          "description": "Emitted Armament partially ignores remaining armor.",
          "cost": 280,
          "modifiers": {
            "armorIgnore": 0.2
          }
        },
        {
          "name": "Internal Destruction",
          "description": "A portion of ordinary damage becomes internal and bypasses armor.",
          "cost": 370,
          "modifiers": {
            "internalFraction": 0.2
          }
        },
        {
          "name": "Advanced Hardening",
          "description": "More disciplined coating adds further flat damage to attacks and Techniques.",
          "cost": 470,
          "modifiers": {
            "flatDamage": 10
          }
        },
        {
          "name": "Conqueror-Coated Impact",
          "description": "Advanced Haki improves armor bypass and internal damage; eligible contacts can briefly stun.",
          "cost": 600,
          "modifiers": {
            "armorIgnore": 0.35,
            "internalFraction": 0.35,
            "contactStun": 0.45
          }
        }
      ]
    },
    {
      "id": "haki-sense-and-freedom",
      "name": "Haki Sense and Freedom",
      "description": "Observation and Supreme King control improve timing, awareness, pulses and emission. Pulse and emission are bounded gameplay adaptations, not elemental attacks or terrain creation.",
      "upgrades": [
        {
          "name": "Observation Focus",
          "description": "Sharper anticipation accelerates Luffy's primary attack cycle.",
          "cost": 200,
          "modifiers": {
            "primaryTimingMultiplier": 0.92
          }
        },
        {
          "name": "Future Glimpse",
          "description": "Further short-term prediction accelerates primary timing again.",
          "cost": 290,
          "modifiers": {
            "primaryTimingMultiplier": 0.84
          }
        },
        {
          "name": "Selective Haki Sense",
          "description": "Observation awareness reveals concealed targets to Luffy's primary acquisition.",
          "cost": 380,
          "modifiers": {
            "detectConcealed": true
          }
        },
        {
          "name": "Supreme King Pulse",
          "description": "Periodic primary cycles emit a bounded eligible-target pulse that can stun weak-willed foes.",
          "cost": 490,
          "modifiers": {
            "pulse": {
              "cycles": 2,
              "radius": 8,
              "cap": 5,
              "stun": 0.8,
              "interval": 1.2
            }
          }
        },
        {
          "name": "Conqueror Emission",
          "description": "A contact-triggered Haki emission projects force beyond the primary reach without triggering other effects or counters.",
          "cost": 620,
          "modifiers": {
            "emission": {
              "cycles": 1,
              "damage": 18,
              "width": 1.5,
              "length": 16,
              "cap": 1
            }
          }
        }
      ]
    }
  ]
}
