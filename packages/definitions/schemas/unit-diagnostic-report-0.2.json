{
  "$id": "https://mardwerk.org/schemas/unit-diagnostic-report/0.2.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "unitId",
    "hardAcceptance",
    "diagnosticEligibility",
    "rawMetrics",
    "normalizedMetrics",
    "assessment",
    "reviewFindings",
    "evidence",
    "warnings",
    "diagnosticProfileId",
    "diagnosticProfileVersion",
    "calibrationStatus"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.2",
      "type": "string"
    },
    "unitId": {
      "type": "string"
    },
    "hardAcceptance": {
      "type": "boolean"
    },
    "diagnosticEligibility": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "eligible",
        "reasons"
      ],
      "properties": {
        "eligible": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "rawMetrics": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "pathIdentity",
        "pathDistinctness",
        "progressionCoherence",
        "baseContinuity",
        "abilityIntegration",
        "complexityEconomy",
        "marginalUpgradeValue",
        "powerCurveShape",
        "crossPathHealth",
        "roleConsistency",
        "scenarioRobustness"
      ],
      "properties": {
        "pathIdentity": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "number"
        },
        "pathDistinctness": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "number"
        },
        "progressionCoherence": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "number"
        },
        "baseContinuity": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "number"
        },
        "abilityIntegration": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "number"
        },
        "complexityEconomy": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "number"
        },
        "marginalUpgradeValue": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "number"
        },
        "powerCurveShape": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "number"
        },
        "crossPathHealth": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "number"
        },
        "roleConsistency": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "number"
        },
        "scenarioRobustness": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "number"
        }
      }
    },
    "normalizedMetrics": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "pathIdentity",
        "pathDistinctness",
        "progressionCoherence",
        "baseContinuity",
        "abilityIntegration",
        "complexityEconomy",
        "marginalUpgradeValue",
        "powerCurveShape",
        "crossPathHealth",
        "roleConsistency",
        "scenarioRobustness"
      ],
      "properties": {
        "pathIdentity": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "number"
        },
        "pathDistinctness": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "number"
        },
        "progressionCoherence": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "number"
        },
        "baseContinuity": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "number"
        },
        "abilityIntegration": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "number"
        },
        "complexityEconomy": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "number"
        },
        "marginalUpgradeValue": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "number"
        },
        "powerCurveShape": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "number"
        },
        "crossPathHealth": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "number"
        },
        "roleConsistency": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "number"
        },
        "scenarioRobustness": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "number"
        }
      }
    },
    "assessment": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "status",
        "generalQuality",
        "unknownDimensions"
      ],
      "properties": {
        "status": {
          "anyOf": [
            {
              "const": "invalid",
              "type": "string"
            },
            {
              "const": "needs-review",
              "type": "string"
            },
            {
              "const": "unrated",
              "type": "string"
            }
          ]
        },
        "generalQuality": {
          "const": "unrated",
          "type": "string"
        },
        "unknownDimensions": {
          "uniqueItems": true,
          "type": "array",
          "items": {
            "anyOf": [
              {
                "const": "source-fidelity",
                "type": "string"
              },
              {
                "const": "gameplay-quality",
                "type": "string"
              },
              {
                "const": "competitive-balance",
                "type": "string"
              }
            ]
          }
        }
      }
    },
    "reviewFindings": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "code",
              "summary",
              "parentSelection",
              "childSelection",
              "relativeUtilityGain",
              "scenarioIds",
              "scenarioFingerprints",
              "facts"
            ],
            "properties": {
              "code": {
                "anyOf": [
                  {
                    "const": "SCENARIO_NO_UTILITY_GAIN",
                    "type": "string"
                  },
                  {
                    "const": "SCENARIO_LOW_UTILITY_GAIN",
                    "type": "string"
                  },
                  {
                    "const": "SCENARIO_REGRESSING_UPGRADE_EDGE",
                    "type": "string"
                  }
                ]
              },
              "summary": {
                "type": "string"
              },
              "parentSelection": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "upgradeIds"
                ],
                "properties": {
                  "upgradeIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "formIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "childSelection": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "upgradeIds"
                ],
                "properties": {
                  "upgradeIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "formIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "relativeUtilityGain": {
                "minimum": -9007199254740991,
                "maximum": 9007199254740991,
                "type": "number"
              },
              "scenarioIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "scenarioFingerprints": {
                "type": "array",
                "items": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                }
              },
              "facts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "code",
              "summary",
              "dominantSelection",
              "dominatedSelection",
              "dominantCostCredits",
              "dominatedCostCredits",
              "scenarioIds",
              "scenarioFingerprints",
              "facts"
            ],
            "properties": {
              "code": {
                "const": "SCENARIO_DOMINATED_CROSS_PATH_BUILD",
                "type": "string"
              },
              "summary": {
                "type": "string"
              },
              "dominantSelection": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "upgradeIds"
                ],
                "properties": {
                  "upgradeIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "formIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "dominatedSelection": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "upgradeIds"
                ],
                "properties": {
                  "upgradeIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "formIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "dominantCostCredits": {
                "minimum": 0,
                "maximum": 9007199254740991,
                "type": "number"
              },
              "dominatedCostCredits": {
                "minimum": 0,
                "maximum": 9007199254740991,
                "type": "number"
              },
              "scenarioIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "scenarioFingerprints": {
                "type": "array",
                "items": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                }
              },
              "facts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "metric",
          "status",
          "raw",
          "normalized",
          "summary",
          "facts"
        ],
        "properties": {
          "metric": {
            "anyOf": [
              {
                "const": "pathIdentity",
                "type": "string"
              },
              {
                "const": "pathDistinctness",
                "type": "string"
              },
              {
                "const": "progressionCoherence",
                "type": "string"
              },
              {
                "const": "baseContinuity",
                "type": "string"
              },
              {
                "const": "abilityIntegration",
                "type": "string"
              },
              {
                "const": "complexityEconomy",
                "type": "string"
              },
              {
                "const": "marginalUpgradeValue",
                "type": "string"
              },
              {
                "const": "powerCurveShape",
                "type": "string"
              },
              {
                "const": "crossPathHealth",
                "type": "string"
              },
              {
                "const": "roleConsistency",
                "type": "string"
              },
              {
                "const": "scenarioRobustness",
                "type": "string"
              }
            ]
          },
          "status": {
            "anyOf": [
              {
                "const": "measured",
                "type": "string"
              },
              {
                "const": "unavailable",
                "type": "string"
              },
              {
                "const": "unsupported",
                "type": "string"
              }
            ]
          },
          "raw": {
            "minimum": 0,
            "maximum": 9007199254740991,
            "type": "number"
          },
          "normalized": {
            "minimum": 0,
            "maximum": 9007199254740991,
            "type": "number"
          },
          "summary": {
            "type": "string"
          },
          "facts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "diagnosticProfileId": {
      "type": "string"
    },
    "diagnosticProfileVersion": {
      "type": "string"
    },
    "calibrationStatus": {
      "anyOf": [
        {
          "const": "uncalibrated",
          "type": "string"
        },
        {
          "const": "synthetic initial calibration",
          "type": "string"
        }
      ]
    }
  }
}
