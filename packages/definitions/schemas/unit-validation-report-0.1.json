{
  "$id": "https://mardwerk.org/schemas/unit-validation-report/0.1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "valid",
    "issues",
    "warnings",
    "quality",
    "audit",
    "balance"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1",
      "type": "string"
    },
    "valid": {
      "type": "boolean"
    },
    "issues": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "path",
          "message",
          "category"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "category": {
            "anyOf": [
              {
                "const": "schema",
                "type": "string"
              },
              {
                "const": "reference",
                "type": "string"
              },
              {
                "const": "graph",
                "type": "string"
              },
              {
                "const": "operation",
                "type": "string"
              },
              {
                "const": "mechanic",
                "type": "string"
              },
              {
                "const": "simulation",
                "type": "string"
              }
            ]
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "quality": {
      "anyOf": [
        {
          "$id": "https://mardwerk.org/schemas/unit-quality-report/0.1.json",
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "type": "object",
          "required": [
            "schemaVersion",
            "unitId",
            "hardAcceptance",
            "scoreEligibility",
            "rawMetrics",
            "normalizedMetrics",
            "compositeScore",
            "evidence",
            "warnings",
            "scoreProfileId",
            "scoreProfileVersion",
            "calibrationStatus"
          ],
          "properties": {
            "schemaVersion": {
              "const": "0.1",
              "type": "string"
            },
            "unitId": {
              "type": "string"
            },
            "hardAcceptance": {
              "type": "boolean"
            },
            "scoreEligibility": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "eligible",
                "reasons"
              ],
              "properties": {
                "eligible": {
                  "type": "boolean"
                },
                "reasons": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "rawMetrics": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "pathIdentity",
                "pathDistinctness",
                "progressionCoherence",
                "baseContinuity",
                "abilityIntegration",
                "complexityEconomy",
                "marginalUpgradeValue",
                "powerCurveShape",
                "crossPathHealth",
                "roleConsistency",
                "scenarioRobustness"
              ],
              "properties": {
                "pathIdentity": {
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "type": "number"
                },
                "pathDistinctness": {
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "type": "number"
                },
                "progressionCoherence": {
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "type": "number"
                },
                "baseContinuity": {
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "type": "number"
                },
                "abilityIntegration": {
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "type": "number"
                },
                "complexityEconomy": {
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "type": "number"
                },
                "marginalUpgradeValue": {
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "type": "number"
                },
                "powerCurveShape": {
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "type": "number"
                },
                "crossPathHealth": {
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "type": "number"
                },
                "roleConsistency": {
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "type": "number"
                },
                "scenarioRobustness": {
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "type": "number"
                }
              }
            },
            "normalizedMetrics": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "pathIdentity",
                "pathDistinctness",
                "progressionCoherence",
                "baseContinuity",
                "abilityIntegration",
                "complexityEconomy",
                "marginalUpgradeValue",
                "powerCurveShape",
                "crossPathHealth",
                "roleConsistency",
                "scenarioRobustness"
              ],
              "properties": {
                "pathIdentity": {
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "type": "number"
                },
                "pathDistinctness": {
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "type": "number"
                },
                "progressionCoherence": {
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "type": "number"
                },
                "baseContinuity": {
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "type": "number"
                },
                "abilityIntegration": {
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "type": "number"
                },
                "complexityEconomy": {
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "type": "number"
                },
                "marginalUpgradeValue": {
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "type": "number"
                },
                "powerCurveShape": {
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "type": "number"
                },
                "crossPathHealth": {
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "type": "number"
                },
                "roleConsistency": {
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "type": "number"
                },
                "scenarioRobustness": {
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "type": "number"
                }
              }
            },
            "compositeScore": {
              "anyOf": [
                {
                  "minimum": 0,
                  "maximum": 100,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "metric",
                  "status",
                  "raw",
                  "normalized",
                  "summary",
                  "facts"
                ],
                "properties": {
                  "metric": {
                    "anyOf": [
                      {
                        "const": "pathIdentity",
                        "type": "string"
                      },
                      {
                        "const": "pathDistinctness",
                        "type": "string"
                      },
                      {
                        "const": "progressionCoherence",
                        "type": "string"
                      },
                      {
                        "const": "baseContinuity",
                        "type": "string"
                      },
                      {
                        "const": "abilityIntegration",
                        "type": "string"
                      },
                      {
                        "const": "complexityEconomy",
                        "type": "string"
                      },
                      {
                        "const": "marginalUpgradeValue",
                        "type": "string"
                      },
                      {
                        "const": "powerCurveShape",
                        "type": "string"
                      },
                      {
                        "const": "crossPathHealth",
                        "type": "string"
                      },
                      {
                        "const": "roleConsistency",
                        "type": "string"
                      },
                      {
                        "const": "scenarioRobustness",
                        "type": "string"
                      }
                    ]
                  },
                  "status": {
                    "anyOf": [
                      {
                        "const": "measured",
                        "type": "string"
                      },
                      {
                        "const": "unavailable",
                        "type": "string"
                      },
                      {
                        "const": "unsupported",
                        "type": "string"
                      }
                    ]
                  },
                  "raw": {
                    "minimum": 0,
                    "maximum": 9007199254740991,
                    "type": "number"
                  },
                  "normalized": {
                    "minimum": 0,
                    "maximum": 9007199254740991,
                    "type": "number"
                  },
                  "summary": {
                    "type": "string"
                  },
                  "facts": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "scoreProfileId": {
              "type": "string"
            },
            "scoreProfileVersion": {
              "type": "string"
            },
            "calibrationStatus": {
              "anyOf": [
                {
                  "const": "uncalibrated",
                  "type": "string"
                },
                {
                  "const": "synthetic initial calibration",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "audit": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "checkedBuilds",
        "checkedForms",
        "checks"
      ],
      "properties": {
        "checkedBuilds": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "checkedForms": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "balance": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "label",
        "estimatedPower",
        "strengths",
        "weaknesses",
        "milestones"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "estimatedPower": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "number"
        },
        "strengths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "weaknesses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "milestones": {
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "selection",
              "costCredits",
              "estimatedDps"
            ],
            "properties": {
              "selection": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "costCredits": {
                "minimum": 0,
                "maximum": 9007199254740991,
                "type": "number"
              },
              "estimatedDps": {
                "minimum": 0,
                "maximum": 9007199254740991,
                "type": "number"
              }
            }
          }
        }
      }
    }
  }
}
