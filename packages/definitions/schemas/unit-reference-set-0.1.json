{
  "$id": "https://mardwerk.org/schemas/unit-reference-set/0.1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "version",
    "unitSpecSchemaVersion",
    "partition",
    "members",
    "normalizationVersion"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1",
      "type": "string"
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "type": "string"
    },
    "version": {
      "minLength": 1,
      "type": "string"
    },
    "unitSpecSchemaVersion": {
      "const": "0.1",
      "type": "string"
    },
    "partition": {
      "anyOf": [
        {
          "const": "development",
          "type": "string"
        },
        {
          "const": "calibration",
          "type": "string"
        },
        {
          "const": "evaluation",
          "type": "string"
        },
        {
          "const": "holdout",
          "type": "string"
        }
      ]
    },
    "members": {
      "minItems": 1,
      "maxItems": 256,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "unitId",
          "familyId",
          "unitArtifactId",
          "annotationArtifactId",
          "coverageArtifactId"
        ],
        "properties": {
          "unitId": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "type": "string"
          },
          "familyId": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "type": "string"
          },
          "unitArtifactId": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "type": "string"
          },
          "annotationArtifactId": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "type": "string"
          },
          "coverageArtifactId": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "type": "string"
          },
          "provenanceArtifactId": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "type": "string"
          }
        }
      }
    },
    "normalizationVersion": {
      "minLength": 1,
      "type": "string"
    },
    "sourceSnapshotId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "type": "string"
    }
  }
}
