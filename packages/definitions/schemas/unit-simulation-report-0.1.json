{
  "$id": "https://mardwerk.org/schemas/unit-simulation-report/0.1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "unitId",
    "buildFingerprint",
    "scenarioFingerprint",
    "scenarioId",
    "seed",
    "durationSeconds",
    "damageHitPoints",
    "kills",
    "hits",
    "targetsAffected",
    "statusUptimeTargetSeconds",
    "resourcesGenerated",
    "resourcesSpent",
    "economyGeneratedCredits",
    "abilityContributionHitPoints",
    "summonContributionHitPoints",
    "firstEffectSeconds",
    "targetingFailures",
    "damageByAction",
    "eventCount",
    "warnings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1",
      "type": "string"
    },
    "unitId": {
      "type": "string"
    },
    "buildFingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "scenarioFingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "scenarioId": {
      "type": "string"
    },
    "seed": {
      "minimum": 0,
      "maximum": 4294967295,
      "type": "integer"
    },
    "durationSeconds": {
      "minimum": 0,
      "maximum": 9007199254740991,
      "type": "number"
    },
    "damageHitPoints": {
      "minimum": 0,
      "maximum": 9007199254740991,
      "type": "number"
    },
    "kills": {
      "minimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "hits": {
      "minimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "targetsAffected": {
      "minimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "statusUptimeTargetSeconds": {
      "minimum": 0,
      "maximum": 9007199254740991,
      "type": "number"
    },
    "resourcesGenerated": {
      "type": "object",
      "patternProperties": {
        "^(.*)$": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "number"
        }
      }
    },
    "resourcesSpent": {
      "type": "object",
      "patternProperties": {
        "^(.*)$": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "number"
        }
      }
    },
    "economyGeneratedCredits": {
      "minimum": -9007199254740991,
      "maximum": 9007199254740991,
      "type": "number"
    },
    "abilityContributionHitPoints": {
      "minimum": 0,
      "maximum": 9007199254740991,
      "type": "number"
    },
    "summonContributionHitPoints": {
      "minimum": 0,
      "maximum": 9007199254740991,
      "type": "number"
    },
    "firstEffectSeconds": {
      "anyOf": [
        {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "targetingFailures": {
      "minimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "damageByAction": {
      "type": "object",
      "patternProperties": {
        "^(.*)$": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "number"
        }
      }
    },
    "eventCount": {
      "minimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
