{
  "$id": "https://mardwerk.org/schemas/unit-reference-provenance/0.1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "unitId",
    "normalizationVersion",
    "sourceSnapshotId",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1",
      "type": "string"
    },
    "unitId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "type": "string"
    },
    "normalizationVersion": {
      "minLength": 1,
      "type": "string"
    },
    "sourceSnapshotId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "type": "string"
    },
    "records": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "targetPointer",
          "status",
          "sourceArtifact"
        ],
        "properties": {
          "targetPointer": {
            "pattern": "^(?:/(?:[^~/]|~[01])*)*$",
            "type": "string"
          },
          "status": {
            "anyOf": [
              {
                "const": "exact",
                "type": "string"
              },
              {
                "const": "derived",
                "type": "string"
              },
              {
                "const": "inferred",
                "type": "string"
              },
              {
                "const": "approximate",
                "type": "string"
              },
              {
                "const": "unsupported",
                "type": "string"
              }
            ]
          },
          "sourceArtifact": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "type": "string"
          },
          "sourcePointer": {
            "pattern": "^#(?:/(?:[A-Za-z0-9._!$&'()*+,;=:@/?-]|~[01]|%[0-9A-Fa-f]{2})*)?$",
            "type": "string"
          },
          "derivation": {
            "minLength": 1,
            "type": "string"
          },
          "confidence": {
            "minimum": 0,
            "maximum": 1,
            "type": "number"
          },
          "note": {
            "minLength": 1,
            "type": "string"
          }
        }
      }
    }
  }
}
