{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "purpose",
    "durationSeconds",
    "seed",
    "abilityPolicy",
    "enemies"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1",
      "type": "string"
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "type": "string"
    },
    "purpose": {
      "minLength": 1,
      "maxLength": 512,
      "type": "string"
    },
    "durationSeconds": {
      "exclusiveMinimum": 0,
      "maximum": 120,
      "type": "number"
    },
    "seed": {
      "minimum": 0,
      "maximum": 4294967295,
      "type": "integer"
    },
    "abilityPolicy": {
      "anyOf": [
        {
          "const": "never",
          "type": "string"
        },
        {
          "const": "automatic",
          "type": "string"
        },
        {
          "const": "on-cooldown",
          "type": "string"
        }
      ]
    },
    "enemies": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "spawnSeconds",
          "startDistanceWorldUnits",
          "speedWorldUnitsPerSecond",
          "healthHitPoints",
          "tags",
          "resistances"
        ],
        "properties": {
          "id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "type": "string"
          },
          "spawnSeconds": {
            "minimum": 0,
            "maximum": 120,
            "type": "number"
          },
          "startDistanceWorldUnits": {
            "minimum": 0,
            "maximum": 1000000,
            "type": "number"
          },
          "speedWorldUnitsPerSecond": {
            "minimum": 0,
            "maximum": 1000000,
            "type": "number"
          },
          "healthHitPoints": {
            "exclusiveMinimum": 0,
            "maximum": 1000000000000,
            "type": "number"
          },
          "tags": {
            "maxItems": 64,
            "uniqueItems": true,
            "type": "array",
            "items": {
              "minLength": 1,
              "maxLength": 128,
              "type": "string"
            }
          },
          "resistances": {
            "maxProperties": 64,
            "type": "object",
            "patternProperties": {
              "^(.*)$": {
                "minimum": 0,
                "maximum": 1,
                "type": "number"
              }
            }
          }
        }
      }
    }
  },
  "$id": "https://mardwerk.org/schemas/unit-simulation-scenario/0.1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
