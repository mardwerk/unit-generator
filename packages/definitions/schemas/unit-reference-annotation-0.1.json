{
  "$id": "https://mardwerk.org/schemas/unit-reference-annotation/0.1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "unitId",
    "qualityClass",
    "expectedHardAcceptance",
    "declaredRoles",
    "mechanicFamilies",
    "knownLimitations",
    "annotationVersion"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1",
      "type": "string"
    },
    "unitId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "type": "string"
    },
    "qualityClass": {
      "anyOf": [
        {
          "const": "mature-reference",
          "type": "string"
        },
        {
          "const": "generalization-reference",
          "type": "string"
        },
        {
          "const": "compatibility-only",
          "type": "string"
        }
      ]
    },
    "expectedHardAcceptance": {
      "type": "boolean"
    },
    "expectedProfile": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "type": "string"
    },
    "declaredRoles": {
      "minItems": 1,
      "uniqueItems": true,
      "maxItems": 256,
      "type": "array",
      "items": {
        "minLength": 1,
        "type": "string"
      }
    },
    "mechanicFamilies": {
      "uniqueItems": true,
      "maxItems": 256,
      "type": "array",
      "items": {
        "minLength": 1,
        "type": "string"
      }
    },
    "knownLimitations": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "minLength": 1,
        "type": "string"
      }
    },
    "annotationVersion": {
      "minLength": 1,
      "type": "string"
    }
  }
}
