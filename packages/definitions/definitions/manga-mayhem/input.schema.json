{
  "$id": "mardwerk.manga-mayhem.input/0.1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subject"
  ],
  "properties": {
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "kind": {
      "enum": [
        "character",
        "original"
      ]
    },
    "continuity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "intent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "knowledge": {
      "type": "object"
    },
    "sources": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 2048
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "content",
              "origin",
              "status",
              "truncated",
              "omissions"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "content": {
                "type": "string",
                "maxLength": 262144
              },
              "url": {
                "type": "string",
                "maxLength": 2048
              },
              "origin": {
                "enum": [
                  "supplied",
                  "retrieved"
                ]
              },
              "status": {
                "enum": [
                  "read",
                  "failed"
                ]
              },
              "truncated": {
                "type": "boolean"
              },
              "omissions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8000
                },
                "maxItems": 20
              },
              "error": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              }
            }
          }
        ]
      }
    },
    "context": {}
  }
}
