  "paths": [
    {
      "id": "conqueror",
      "name": "Conqueror's Haki",
      "upgrades": [
        {
          "name": "Overwhelming presence",
          "cost": 150,
          "modifiers": {
            "contactStun": 0.15
          },
          "description": "Damaging contacts stun weak-willed, stunnable enemies for 0.15 seconds. Stun protection prevents repeated interruption."
        },
        {
          "name": "Conqueror's burst",
          "cost": 300,
          "modifiers": {
            "pulse": {
              "cycles": 3,
              "radius": 12,
              "cap": 6,
              "stun": 0.4,
              "interval": 2
            }
          },
          "description": "Every three successful primary cycles can release a radius-12 pulse, stunning up to six eligible enemies for 0.4 seconds. Pulses are at least two seconds apart."
        },
        {
          "name": "Commanding presence",
          "cost": 650,
          "modifiers": {
            "pulse": {
              "cycles": 3,
              "radius": 18,
              "cap": 8,
              "stun": 0.75,
              "interval": 2
            }
          },
          "description": "Increase pulse radius to 18, target cap to eight and stun duration to 0.75 seconds."
        },
        {
          "name": "Conqueror's coating",
          "cost": 1600,
          "modifiers": {
            "damageMultiplier": 1.2
          },
          "description": "Multiply primary and Technique contact damage by 1.20, including against control-immune targets."
        },
        {
          "name": "Supreme conqueror",
          "cost": 4500,
          "modifiers": {
            "pulse": {
              "cycles": 2,
              "radius": 24,
              "cap": 12,
              "stun": 1.2,
              "interval": 2
            }
          },
          "description": "Pulse after two successful primary cycles, with radius 24, twelve targets and 1.2-second stuns. Keep the two-second minimum interval."
        }
      ]
    },
    {
      "id": "observation",
      "name": "Observation Haki",
      "upgrades": [
        {
          "name": "Sense presence",
          "cost": 180,
          "modifiers": {
            "detectConcealed": true
          },
          "description": "Acquire and damage concealed enemies within reach. Obstacles still block contact."
        },
        {
          "name": "Read the movement",
          "cost": 350,
          "modifiers": {
            "primaryTimingMultiplier": 0.85
          },
          "description": "Multiply primary period and windup by 0.85. Technique timing stays unchanged."
        },
        {
          "name": "Future Sight",
          "cost": 700,
          "modifiers": {
            "retargetPrimary": true
          },
          "description": "If a primary target is lost during windup, select one eligible replacement at resolution without restarting the cycle."
        },
        {
          "name": "Wider awareness",
          "cost": 1700,
          "modifiers": {
            "reachAdd": 12
          },
          "description": "Add 12 reach to every primary profile and its contextual Technique."
        },
        {
          "name": "Unbroken focus",
          "cost": 4500,
          "modifiers": {
            "primaryTimingMultiplier": 0.75
          },
          "description": "Multiply primary timing by another 0.75, reaching 0.6375 of original period and windup."
        }
      ]
    },
    {
      "id": "armament",
      "name": "Armament Haki",
      "upgrades": [
        {
          "name": "Hardened fists",
          "cost": 200,
          "modifiers": {
            "flatDamage": 4
          },
          "description": "Add four physical damage to every primary and Technique contact before damage multipliers."
        },
        {
          "name": "Hardened impact",
          "cost": 400,
          "modifiers": {
            "armorIgnore": 0.25
          },
          "description": "Ignore 25 percent of target armor reduction. A 40 percent reduction becomes 30 percent."
        },
        {
          "name": "Emission",
          "cost": 850,
          "modifiers": {
            "emission": {
              "cycles": 3,
              "damage": 30,
              "width": 3,
              "length": 8,
              "cap": 3
            }
          },
          "description": "Every third successful primary cycle deals a 30-damage Haki impact to up to three enemies along an eight-unit extension from contact. It excludes the flat damage addition."
        },
        {
          "name": "Internal Destruction",
          "cost": 2000,
          "modifiers": {
            "internalFraction": 0.2
          },
          "description": "Convert 20 percent of contact damage into armor-bypassing internal damage. Unarmored damage stays unchanged."
        },
        {
          "name": "Mastered Armament",
          "cost": 5000,
          "modifiers": {
            "internalFraction": 0.35,
            "damageMultiplier": 1.35
          },
          "description": "Increase internal conversion to 35 percent and multiply contact and Emission damage by 1.35."
        }
      ]
    }
  ]
