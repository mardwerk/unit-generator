{
  "$id": "https://mardwerk.org/definitions/classic-three-path/input/0.2.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subject"
  ],
  "properties": {
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "kind": {
      "enum": [
        "character",
        "original"
      ]
    },
    "continuity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "intent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "knowledge": {
      "type": "object"
    },
    "sources": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 2048
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "content",
              "origin",
              "status",
              "truncated",
              "omissions"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "content": {
                "type": "string",
                "maxLength": 262144
              },
              "url": {
                "type": "string",
                "maxLength": 2048
              },
              "origin": {
                "enum": [
                  "supplied",
                  "retrieved"
                ]
              },
              "status": {
                "enum": [
                  "read",
                  "failed"
                ]
              },
              "truncated": {
                "type": "boolean"
              },
              "omissions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8000
                },
                "maxItems": 20
              },
              "error": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              }
            }
          }
        ]
      }
    },
    "context": {},
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "noManualAbilities": {
          "type": "boolean"
        },
        "excludedMechanics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "maxItems": 16,
          "uniqueItems": true
        },
        "allowedMechanics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "maxItems": 16,
          "uniqueItems": true
        },
        "requiredRoles": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "damage",
              "control",
              "burst",
              "support",
              "economy"
            ]
          }
        },
        "placementCostBand": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "maxProminentMechanics": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        }
      }
    }
  }
}
