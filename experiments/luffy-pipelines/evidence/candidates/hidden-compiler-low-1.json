      "omissions": [
        {
          "trait": "Rubber-body immunity and blunt-force resistance",
          "reason": "The prototype supports attack delivery and listed effects, but not defensive resistances."
        },
        {
          "trait": "Gear 4 and Gear 5 transformations",
          "reason": "Runtime transformations and encounter forms are explicitly unsupported; they were not represented as state changes."
        },
        {
          "trait": "Awakened environment rubberization",
          "reason": "The prototype has no environment transformation or custom area conversion mechanic."
        },
        {
          "trait": "Future Sight",
          "reason": "The available action model cannot represent predictive states or conditional evasion."
        },
        {
          "trait": "Conqueror's Haki unconsciousness",
          "reason": "A stun effect is representable, but using it would add a prominent control mechanic; this adaptation prioritizes Luffy's attack progression and manual Haki burst."
        },
        {
          "trait": "Elastic movement and aerial propulsion",
          "reason": "The source supports movement-inspired attacks, but no movement action was needed to express the tower's core offensive identity."
        },
        {
          "trait": "Water and Sea-Prism Stone weakness",
          "reason": "The prototype has no environmental weakness or resource-state system."
        },
        {
          "trait": "Crew, fleet, and alliance leadership",
          "reason": "Summons, secondary actions, and economy effects are unsupported."
        },
        {
          "trait": "Poison immunity",
          "reason": "The prototype does not provide resistance or immunity effects."
        }
      ]
