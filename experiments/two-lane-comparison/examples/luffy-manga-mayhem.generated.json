  "paths": [
    {
      "id": "conquerors",
      "name": "Conqueror's Haki",
      "description": "Eligible weak-willed enemy control, then coating damage. Only this path owns pulse configurations. Shared Gear unlocks use the highest purchased tier.",
      "upgrades": [
        {
          "name": "Intimidating Contact",
          "cost": 300,
          "description": "Briefly stuns weak-willed, stunnable targets on contact. Provides an inexpensive control crosspath; unlocks Gear Second.",
          "modifiers": {
            "contactStun": 0.3
          }
        },
        {
          "name": "Conqueror's Pressure",
          "cost": 650,
          "description": "Successful primary cycles build a bounded nearby stun pulse. Unlocks Gear Third.",
          "modifiers": {
            "pulse": {
              "cycles": 4,
              "radius": 10,
              "cap": 5,
              "stun": 0.8,
              "interval": 5
            }
          }
        },
        {
          "name": "Focused Will",
          "cost": 1300,
          "description": "Replaces the pulse with a faster, wider, stronger configuration. Unlocks the bounded Second + Third combination.",
          "modifiers": {
            "contactStun": 0.5,
            "pulse": {
              "cycles": 3,
              "radius": 13,
              "cap": 8,
              "stun": 1.2,
              "interval": 4.5
            }
          }
        },
        {
          "name": "Conqueror's Coating",
          "cost": 2600,
          "description": "Coating increases damage even against control-immune enemies. Unlocks all three Gear Fourth variants.",
          "modifiers": {
            "damageMultiplier": 1.35
          }
        },
        {
          "name": "Supreme Coating",
          "cost": 4400,
          "description": "Further multiplies coating damage and strengthens the bounded pulse. Unlocks Gear Fifth.",
          "modifiers": {
            "damageMultiplier": 1.3,
            "pulse": {
              "cycles": 3,
              "radius": 15,
              "cap": 12,
              "stun": 1.6,
              "interval": 4
            }
          }
        }
      ]
    },
    {
      "id": "observation",
      "name": "Observation Haki",
      "description": "Presence sensing and anticipation become detection, reliable primary acquisition, effective reach and cadence; never obstacle penetration or invulnerability bypass.",
      "upgrades": [
        {
          "name": "Presence Sensing",
          "cost": 300,
          "description": "Detects concealed enemies and adds effective contact reach. Unlocks Gear Second.",
          "modifiers": {
            "detectConcealed": true,
            "reachAdd": 1
          }
        },
        {
          "name": "Read the Next Move",
          "cost": 650,
          "description": "Replaces a lost primary target at contact without restarting windup; slightly improves primary cadence. Unlocks Gear Third.",
          "modifiers": {
            "retargetPrimary": true,
            "primaryTimingMultiplier": 0.94
          }
        },
        {
          "name": "Anticipated Contact",
          "cost": 1300,
          "description": "Earlier acquisition is represented by additional effective reach and faster primary timing. Unlocks Second + Third.",
          "modifiers": {
            "reachAdd": 2,
            "primaryTimingMultiplier": 0.88
          }
        },
        {
          "name": "Future Sight",
          "cost": 2600,
          "description": "Improves primary cadence and effective coverage, without dodging or retargeting Techniques. Unlocks Gear Fourth variants.",
          "modifiers": {
            "reachAdd": 2,
            "primaryTimingMultiplier": 0.8
          }
        },
        {
          "name": "Sustained Anticipation",
          "cost": 4400,
          "description": "Further expands primary coverage and cadence for sustained base attacks or temporary Gears. Unlocks Gear Fifth.",
          "modifiers": {
            "reachAdd": 3,
            "primaryTimingMultiplier": 0.78
          }
        }
      ]
    },
    {
      "id": "armament",
      "name": "Armament Haki",
      "description": "Contact reinforcement, armor reduction, bounded emission and internal penetration. Only this path owns emission; internal damage never bypasses invulnerability.",
      "upgrades": [
        {
          "name": "Hardened Contact",
          "cost": 300,
          "description": "Adds contact damage and ignores part of armor reduction. Especially useful on rapid Gears. Unlocks Gear Second.",
          "modifiers": {
            "flatDamage": 6,
            "armorIgnore": 0.15
          }
        },
        {
          "name": "Reinforced Coating",
          "cost": 650,
          "description": "Adds further contact damage and raises armor ignore for an anti-armor crosspath. Unlocks Gear Third.",
          "modifiers": {
            "flatDamage": 8,
            "armorIgnore": 0.35
          }
        },
        {
          "name": "Advanced Emission",
          "cost": 1300,
          "description": "Every third successful primary cycle emits a short, obstacle-stopped contact-origin extension. Unlocks Second + Third.",
          "modifiers": {
            "armorIgnore": 0.5,
            "emission": {
              "cycles": 3,
              "damage": 45,
              "width": 2,
              "length": 4,
              "cap": 3
            }
          }
        },
        {
          "name": "Internal Destruction",
          "cost": 2600,
          "description": "Routes part of contact damage internally, bypassing armor but not invulnerability. Unlocks Gear Fourth variants.",
          "modifiers": {
            "internalFraction": 0.4,
            "damageMultiplier": 1.15
          }
        },
        {
          "name": "Deep Internal Penetration",
          "cost": 4400,
          "description": "Increases internal damage share and replaces emission with a stronger bounded extension. Unlocks Gear Fifth.",
          "modifiers": {
            "internalFraction": 0.7,
            "damageMultiplier": 1.2,
            "emission": {
              "cycles": 3,
              "damage": 75,
              "width": 2.5,
              "length": 5,
              "cap": 4
            }
          }
        }
      ]
    }
  ]
}
