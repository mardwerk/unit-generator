FROM docker.io/library/node:24-bookworm-slim AS build
RUN npm install --global pnpm@10.18.3
WORKDIR /workspace/foundation
COPY foundation/LICENSE foundation/NOTICE ./
# Copy only build inputs. Sibling checkouts retain their link: dependency layout.
COPY foundation/package.json foundation/pnpm-lock.yaml foundation/pnpm-workspace.yaml foundation/tsconfig.base.json ./
COPY foundation/packages/manifest/package.json foundation/packages/manifest/tsconfig.json ./packages/manifest/
COPY foundation/packages/manifest/NOTICE ./packages/manifest/
COPY foundation/packages/manifest/src ./packages/manifest/src
COPY foundation/packages/model-client/package.json foundation/packages/model-client/tsconfig.json ./packages/model-client/
COPY foundation/packages/model-client/NOTICE ./packages/model-client/
COPY foundation/packages/model-client/src ./packages/model-client/src
COPY foundation/packages/ui/package.json foundation/packages/ui/tsconfig.json ./packages/ui/
COPY foundation/packages/ui/NOTICE ./packages/ui/
COPY foundation/packages/ui/src ./packages/ui/src
COPY foundation/packages/ui/svelte.config.js ./packages/ui/
COPY foundation/packages/manifest/schemas ./packages/manifest/schemas
RUN pnpm install --frozen-lockfile
RUN pnpm --filter './packages/*' build
WORKDIR /workspace/unit-generator
COPY unit-generator/LICENSE unit-generator/NOTICE ./
COPY unit-generator/package.json unit-generator/pnpm-lock.yaml unit-generator/pnpm-workspace.yaml unit-generator/tsconfig.base.json ./
COPY unit-generator/packages/core/package.json unit-generator/packages/core/tsconfig.json ./packages/core/
COPY unit-generator/packages/core/src ./packages/core/src
COPY unit-generator/packages/definitions/package.json unit-generator/packages/definitions/tsconfig.json ./packages/definitions/
COPY unit-generator/packages/definitions/src ./packages/definitions/src
COPY unit-generator/packages/definitions/definitions ./packages/definitions/definitions
COPY unit-generator/packages/providers/package.json unit-generator/packages/providers/tsconfig.json ./packages/providers/
COPY unit-generator/packages/providers/src ./packages/providers/src
COPY unit-generator/packages/reference-lab/package.json unit-generator/packages/reference-lab/tsconfig.json ./packages/reference-lab/
COPY unit-generator/packages/reference-lab/src ./packages/reference-lab/src
COPY unit-generator/apps/cli/package.json unit-generator/apps/cli/tsconfig.json ./apps/cli/
COPY unit-generator/apps/cli/src ./apps/cli/src
COPY unit-generator/apps/web/package.json unit-generator/apps/web/tsconfig.json ./apps/web/
COPY unit-generator/apps/web/src ./apps/web/src
COPY unit-generator/apps/web/svelte.config.js unit-generator/apps/web/vite.config.ts ./apps/web/
RUN pnpm install --frozen-lockfile && pnpm build

FROM docker.io/library/node:24-bookworm-slim AS runtime
ENV NODE_ENV=production HOST=0.0.0.0 PORT=5173 ORIGIN=http://127.0.0.1:5173 BODY_SIZE_LIMIT=4194304
WORKDIR /workspace/unit-generator
COPY --from=build /workspace /workspace
USER node
EXPOSE 5173
CMD ["node", "apps/web/build/index.js"]
