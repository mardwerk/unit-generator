{
  "name": "@mardwerk/unit-generator-workspace",
  "version": "0.2.0",
  "private": true,
  "description": "Stateless game-unit generation with interchangeable definitions.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "boundary:check": "node scripts/check-public-boundary.mjs",
    "build": "pnpm -r --if-present build",
    "build:packages": "pnpm --filter @mardwerk/unit-core --filter @mardwerk/unit-definitions --filter @mardwerk/unit-lab --filter @mardwerk/unit-providers build",
    "check": "pnpm format:check && pnpm lint && pnpm build:packages && pnpm typecheck && pnpm test && pnpm build && pnpm boundary:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^5.43.0"
  }
}
