{
  "name": "@mardwerk/unit-generator-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Build tooling for the mardwerk-unit web app; the Tool itself is the Go binary in src/cli",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node src/web/build.mjs",
    "typecheck": "tsc -p src/web/tsconfig.json",
    "format": "prettier --write \"src/web/**/*.{ts,tsx,mjs,html,css,json}\" \"*.json\" \"data/**/*.json\"",
    "format:check": "prettier --check \"src/web/**/*.{ts,tsx,mjs,html,css,json}\" \"*.json\" \"data/**/*.json\""
  },
  "dependencies": {
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.8",
    "typescript": "^5.9.0"
  }
}
