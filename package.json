{
  "name": "@mardwerk/unit-generator-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Build tooling for the mardwerk-unit web app; the Tool itself is the Go binary in src/cli",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node src/web/build.mjs",
    "typecheck": "tsc -p src/web/tsconfig.json",
    "format": "prettier --write \"src/web/**/*.{ts,tsx,mjs,html,css,json}\" \"*.json\" \"data/**/*.json\"",
    "format:check": "prettier --check \"src/web/**/*.{ts,tsx,mjs,html,css,json}\" \"*.json\" \"data/**/*.json\""
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "get-nonce": "^1.0.1",
    "lucide-react": "^1.47.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.28",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.0"
  }
}
